# ---- Vivado ----
*.jou
*.log
*.str
*.pb
*.wdb
*.wcfg
*.backup.*
.Xil/
xsim.dir/
*.cache/
*.hw/
*.ip_user_files/
*.sim/
*.runs/
*.gen/
*.srcs/
vivado_prj/
webtalk*

# ---- simulation output ----
*.vcd
*.fst
*.out
*.vvp
work/
sim/out/
sim/logs/

# ---- software build ----
sw/build/*
*.o
*.elf
*.bin
*.hex
*.coe
*.dis
*.map

# ---- misc ----
__pycache__/
*.pyc
.venv/

# ...but keep the tiny prebuilt program images, so the simulations run
# without a RISC-V toolchain installed. Must come last: the generic *.hex
# rule above would otherwise win.
!sw/build/*.hex
sim/out_cnt/

# ---- Vivado implementation ----
# Checkpoints are hundreds of megabytes and are regenerated by fpga/run_impl.tcl;
# the reports next to them are small and are the actual result, so they stay.
*.dcp
*.saif
clockInfo.txt
dfx_runtime.txt
iter_*_CongestedCLBsAndNets.txt
sim/out_v*/
tight_setup_hold_pins.txt
sim/out_saif*/
fpga/vivado_prj_*/
fpga/netlist_*.v
sim/out_chk/
sim/out_fpga/
sim/out_netlist/
sim_*.log
vivado_gui.log
fpga/xil_*.tmp
paper/*.aux
paper/*.log
paper/*.out
paper/build*.log
sim/out_lat_*/
sim/out_sweep_*/
sweep_*.log

# ---- simulator run directories ----
# run_xsim.ps1 -OutDir creates one directory per configuration, holding nothing
# but regenerable simulator state. Only files directly in sim/ are tracked, so
# one rule covers every run directory and supersedes the enumerated sim/out_*
# entries above, which were added one at a time as sweeps were written.
sim/*/

# Start-Process writes stderr to a sibling of the stdout redirect, and *.log
# above does not cover the .err suffix. These are transient run logs.
*.log.err
